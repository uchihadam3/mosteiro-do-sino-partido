{
  "name": "mosteiro-do-sino-partido",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mosteiro/web",
    "build": "npm run build -w @mosteiro/web",
    "preview": "npm run preview -w @mosteiro/web",
    "typecheck": "tsc -b packages/core packages/content apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "tsx tools/sim/run-sim.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/ws": "^8.5.13",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
